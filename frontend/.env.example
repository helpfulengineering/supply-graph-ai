# OHM API base URL (no trailing slash)
# The dev server proxies /v1/* to this origin.
OHM_API_BASE_URL=http://localhost:8001

# Optional: seed sessionStorage with this Bearer token when empty (dev only).
# Prefer pasting a key in Settings → Session for day-to-day use.
# NEXT_PUBLIC_OHM_API_KEY=

# ── Optional site layer (default: OFF) ──────────────────────────────────────
# The visitor gate, telemetry, whitelabel config, and Mission Control are a
# per-instance capability. Leave these unset and the instance runs local-only:
# theme and mode preferences live on the device, there is no gate, no
# telemetry, and /mission-control returns 404. That is the default, fully
# supported deployment — not a degraded one.
#
# To enable, create a Supabase project, run supabase/schema.sql in its SQL
# editor, and set both values. The anon key is public by design: it can only
# reach whitelisted SECURITY DEFINER RPCs. Privileged reads need the operator
# token, which is set in the SQL editor and never leaves sessionStorage.
#
# This layer is the SITE layer. It never grants application permissions —
# those come from the backend's whoami. See docs/architecture/site-layer.md.
# NEXT_PUBLIC_OHM_SUPABASE_URL=
# NEXT_PUBLIC_OHM_SUPABASE_ANON_KEY=
