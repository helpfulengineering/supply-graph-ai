{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/require-deploy-environment.sh"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stage-generated-before-commit.sh"
          },
          {
            "type": "command",
            "if": "Bash(git worktree add*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fetch-origin-before-worktree.sh",
            "statusMessage": "Refreshing origin/main",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/no-build-while-serving.sh"
          }
        ]
      },
      {
        "matcher": "EnterWorktree",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fetch-origin-before-worktree.sh",
            "statusMessage": "Refreshing origin/main",
            "timeout": 60
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/fetch-origin-before-worktree.sh",
            "statusMessage": "Refreshing origin/main",
            "timeout": 60,
            "async": true
          }
        ]
      }
    ]
  }
}
